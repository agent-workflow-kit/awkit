{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awkit/audit.json",
  "title": "awkit audit.jsonl record",
  "description": "Public, append-only. awkit audits only what it alone does (cron.install, cron.uninstall, wire, unwire): an attempted record after planning and before any change, and an outcome record after it, sharing attempt_id; one pair per changed file. inputs hold hashes, never the text. There is no decision_id (awkit takes no gate decision in 0.x); no title, body or tool text.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "phase": {
      "enum": [
        "attempted",
        "outcome"
      ]
    },
    "attempt_id": {
      "$ref": "defs.json#/$defs/attempt_id"
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "actor_source": {
      "enum": [
        "flag",
        "tty",
        "default"
      ],
      "description": "flag (--actor), tty (the human default with a terminal), default (auto:unknown)."
    },
    "stdin_tty": {
      "type": "boolean"
    },
    "action": {
      "enum": [
        "cron.install",
        "cron.uninstall",
        "wire",
        "unwire"
      ]
    },
    "target": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?:crontab|/[^\\r\\n]{1,4095})(?![\\s\\S])",
      "description": "The literal crontab, or the absolute path of the drop-in."
    },
    "inputs": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/tool_name"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "before_sha256": {
          "oneOf": [
            {
              "$ref": "defs.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_sha256": {
          "oneOf": [
            {
              "$ref": "defs.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tools",
        "before_sha256",
        "after_sha256"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "attempted",
            "done",
            "failed",
            "unknown"
          ]
        },
        "code": {
          "oneOf": [
            {
              "$ref": "defs.json#/$defs/error_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "unchanged": {
          "type": "boolean"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "$ref": "defs.json#/$defs/tool_name"
              },
              "outcome": {
                "enum": [
                  "done",
                  "failed",
                  "skipped",
                  "wired",
                  "replaced",
                  "removed",
                  "unchanged",
                  "nothing_to_wire"
                ]
              }
            },
            "required": [
              "tool",
              "outcome"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ts",
    "phase",
    "attempt_id",
    "actor",
    "actor_source",
    "stdin_tty",
    "action",
    "target",
    "inputs",
    "result"
  ],
  "additionalProperties": false
}
