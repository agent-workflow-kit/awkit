              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "argv"
          ],
          "additionalProperties": false,
          "description": "The tool's own offline validate: an exit in ok_exits is ok (warn when the warnings path yields a non-empty list), an exit in info_exits is ok with reason info, any other exit fails."
        },
        "probe": {
          "$ref": "#/$defs/argv"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}(?![\\s\\S])"
          },
          "maxItems": 64,
          "uniqueItems": true,
          "description": "Variable names required in awkit's environment or the cron env file."
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._+-]{1,128}(?![\\s\\S])"
          },
          "maxItems": 16,
          "uniqueItems": true,
          "description": "Programs the tool needs (bwrap, socat)."
        },
        "pair": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "defs.json#/$defs/name_id"
