              "tool": {
                "$ref": "defs.json#/$defs/tool_name"
              },
              "min_version": {
                "$ref": "defs.json#/$defs/version"
              }
            },
            "required": [
              "id",
              "tool",
              "min_version"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "description": "Sibling rules; the check id is pair.<id>."
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "validate, probe, env (variable names), needs (programs such as bwrap and socat) and pair (sibling minimum versions)."
    },
