{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awkit/cli/chains.json",
  "title": "chains --json",
  "description": "Chains with the source tag of every link.",
  "type": "object",
  "properties": {
    "chains": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/chain"
      },
      "maxItems": 100000
    },
    "stale": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/tool_name"
      },
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "chains",
    "stale"
  ],
  "additionalProperties": false
}
