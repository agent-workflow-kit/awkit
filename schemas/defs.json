{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awkit/defs.json",
  "title": "awkit shared definitions",
  "$defs": {
    "tool_name": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,31}(?![\\s\\S])",
      "description": "A tool name. Full match."
    },
    "name_id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])",
      "description": "A closed lowercase identifier (read name, action id). Full match."
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])",
      "description": "A closed lowercase code with underscores (a reason, an error code). Full match."
    },
    "actor": {
      "type": "string",
      "maxLength": 70,
      "minLength": 7,
      "pattern": "^(?:human|auto):[A-Za-z0-9._@-]{1,64}(?![\\s\\S])",
      "description": "human:<user> or auto:<name>. Full match."
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "minLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z(?![\\s\\S])",
      "description": "UTC timestamp written by awkit, YYYY-MM-DDTHH:MM:SS.sssZ. Full match."
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "description": "Lowercase hex SHA-256. Full match."
    },
    "attempt_id": {
      "type": "string",
      "maxLength": 22,
      "minLength": 22,
      "pattern": "^[A-Za-z0-9_-]{22}(?![\\s\\S])",
      "description": "Pairs awkit's own attempted record with its outcome (22 characters). Full match."
    },
    "duration": {
      "type": "string",
      "maxLength": 24,
      "minLength": 2,
      "pattern": "^[1-9][0-9]*(?:ms|s|m|h|d)(?![\\s\\S])",
      "description": "A positive integer with the unit ms, s, m, h or d; no bare numbers, no fractions. Full match."
    },
    "abs_path": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^/[^\\r\\n]{0,4095}(?![\\s\\S])",
      "description": "An absolute path (display only). Full match."
    },
    "safe_path": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)[.][.](?:/|(?![\\s\\S])))/[A-Za-z0-9._+@/-]{0,4095}(?![\\s\\S])",
      "description": "An absolute path that awkit may write into a drop-in or pass to a tool's installer: only A-Z a-z 0-9 . _ + @ / -, no // and no .. segment. Full match."
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[0-9][A-Za-z0-9.+_-]{0,63}(?![\\s\\S])",
      "description": "A tool version string. Full match."
    },
    "object_id": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*(?:^|/)[.][.](?:/|(?![\\s\\S])))[A-Za-z0-9/*][A-Za-z0-9._:@/#=+~*-]{0,255}(?![\\s\\S])",
      "description": "An object id as the owning tool prints it; the first character is never -, no .. path segment. Full match.",
      "x-untrusted": true
    },
    "focus_id": {
      "type": "string",
      "maxLength": 300,
      "minLength": 3,
      "pattern": "^(?![\\s\\S]*(?:^|/)[.][.](?:/|(?![\\s\\S])))[a-z][a-z0-9-]{0,31}:[A-Za-z0-9/*][A-Za-z0-9._:@/#=+~*-]{0,255}(?![\\s\\S])",
      "description": "<tool>:<object>, the --focus argument. Full match."
    },
    "hash": {
      "type": "string",
      "maxLength": 128,
      "minLength": 12,
      "pattern": "^[0-9a-f]{12,128}(?![\\s\\S])",
      "description": "A lowercase hex hash of 12 to 128 digits (a plan, content or head hash). Full match."
    },
    "int": {
      "type": "string",
      "maxLength": 18,
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]{0,17})(?![\\s\\S])",
      "description": "A non-negative decimal integer of at most 18 digits without leading zeros. Full match."
    },
    "node_kind": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]{0,31}(?![\\s\\S])",
      "description": "An open node kind; the bundled vocabulary is in the interface (Links and chains). Full match."
    },
    "label_key": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]{0,31}(?![\\s\\S])",
      "description": "An open label key; the bundled vocabulary is in the interface (Links and chains). Full match."
    },
    "severity": {
      "enum": [
        "info",
        "action",
        "error"
      ]
    },
    "link_source": {
      "enum": [
        "record",
        "branch",
        "label"
      ]
    },
    "object_ref": {
      "type": "object",
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool_name"
        },
        "object": {
          "$ref": "#/$defs/object_id"
        },
        "kind": {
          "$ref": "#/$defs/node_kind"
        }
      },
      "required": [
        "tool",
        "object"
      ],
      "additionalProperties": false,
      "description": "One object of one tool. kind is present on chain nodes and links."
    },
    "link": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/object_ref"
        },
        "to": {
          "$ref": "#/$defs/object_ref"
        },
        "source": {
          "$ref": "#/$defs/link_source"
        }
      },
      "required": [
        "from",
        "to",
        "source"
      ],
      "additionalProperties": false,
      "description": "A link between two objects of different tools with its source tag."
    },
    "action_ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/name_id"
        },
        "label": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "x-untrusted": true
        },
        "destructive": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "destructive"
      ],
      "additionalProperties": false,
      "description": "An action an adapter offers for an item (see Actions)."
    },
    "attention_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 400,
          "minLength": 5,
          "x-untrusted": true,
          "description": "<tool>:<reason>:<object>."
        },
        "tool": {
          "$ref": "#/$defs/tool_name"
        },
        "reason": {
          "$ref": "#/$defs/code"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0,
          "x-untrusted": true,
          "description": "Sanitized; cut at 200 code points."
        },
        "object": {
          "$ref": "#/$defs/object_id"
        },
        "since": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "maxItems": 256
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action_ref"
          },
          "maxItems": 64
        }
      },
      "required": [
        "id",
        "tool",
        "reason",
        "severity",
        "title",
        "object",
        "since",
        "links",
        "actions"
      ],
      "additionalProperties": false
    },
    "chain_node": {
      "type": "object",
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool_name"
        },
        "object": {
          "$ref": "#/$defs/object_id"
        },
        "kind": {
          "$ref": "#/$defs/node_kind"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0,
          "x-untrusted": true
        }
      },
      "required": [
        "tool",
        "object",
        "kind"
      ],
      "additionalProperties": false
    },
    "chain": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chain_node"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "maxItems": 256
        }
      },
      "required": [
        "nodes",
        "links"
      ],
      "additionalProperties": false,
      "description": "Nodes (ticket, agent, pull request, review, ...) and the links between them, each with its tag."
    },
    "error_code": {
      "enum": [
        "internal",
        "invalid_argument",
        "missing_option",
        "config_invalid",
        "not_found",
        "unavailable",
        "checks_failed",
        "tool_unavailable",
        "cron_partial",
        "human_required",
        "refused",
        "ambiguous"
      ]
    },
    "error_reason": {
      "enum": [
        "config_unsafe",
        "adapter_invalid",
        "drop_in_foreign",
        "duplicate_state_hooks",
        "stale_object",
        "unsafe_value",
        "xdg_mismatch",
        "unsupported_platform",
        "locked",
        "crontab_failed",
        "crontab_unusable",
        "wire_rejected"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/error_code"
            },
            "message": {
              "type": "string",
              "maxLength": 1000,
              "minLength": 0,
              "x-untrusted": true
            },
            "reason": {
              "$ref": "#/$defs/error_reason"
            },
            "details": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true,
              "x-untrusted": true
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "description": "The envelope printed on stdout for every non-zero exit except doctor's exit 12. reason is present only for exits 12 and 20; details.candidates lists the candidates of exit 21 as <tool>:<object> or site:KEY strings."
    },
    "doctor_status": {
      "enum": [
        "ok",
        "warn",
        "fail"
      ]
    },
    "check_id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]{0,63}(?![\\s\\S])",
      "description": "An open check id. Full match."
    },
    "doctor_check": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/check_id"
        },
        "tool": {
          "oneOf": [
            {
              "$ref": "#/$defs/tool_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/doctor_status"
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1000,
              "minLength": 0,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true,
          "x-untrusted": true
        }
      },
      "required": [
        "id",
        "tool",
        "status",
        "reason",
        "details"
      ],
      "additionalProperties": false
    },
    "doctor_result": {
      "type": "object",
      "properties": {
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "probe": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doctor_check"
          },
          "maxItems": 2000
        },
        "counts": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "integer",
              "minimum": 0
            },
            "warn": {
              "type": "integer",
              "minimum": 0
            },
            "fail": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "ok",
            "warn",
            "fail"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ts",
        "probe",
        "checks",
        "counts"
      ],
      "additionalProperties": false,
      "description": "The result of one doctor run. Also the content of doctor-last.json. Exit 12 prints the same document."
    }
  }
}
